---
interface Props {
  items: string[];
  invertOnHover?: boolean;
  fillOnHover?: boolean;
}

const { items, invertOnHover = true, fillOnHover = false } = Astro.props;
---

<div class="skills-container mx-4 my-2 flex flex-row flex-wrap items-center justify-center gap-x-1.5 gap-y-1.5 text-center">
  {
    items.map((item) => (
      <span
        class:list={[
          "skill-tag inline-block rounded-[2rem] border-2 border-text bg-transparent px-4 py-2 text-[clamp(0.5rem,4vw,1rem)] leading-6 text-text transition-all duration-300 ease-in-out [-webkit-tap-highlight-color:transparent] select-none active:scale-90 active:duration-100 hover:-translate-y-[0.2rem] hover:border-text hover:[font-weight:bold]",
          fillOnHover ? "hover:bg-text hover:text-background" : "hover:bg-background hover:text-text",
          invertOnHover && "group-hover/card:bg-text group-hover/card:text-background",
        ]}
      >
        {item}
      </span>
    ))
  }
</div>
