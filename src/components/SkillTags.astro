---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="skills-container mx-4 my-2 flex flex-row flex-wrap items-center justify-center gap-x-1.5 gap-y-1.5 text-center">
  {
    items.map((item) => (
      <span class="skill-tag inline-block rounded-[2rem] border-2 border-text bg-transparent px-4 py-2 text-base text-text transition-all duration-300 ease-in-out [-webkit-tap-highlight-color:transparent] select-none active:scale-90 active:duration-100 group-hover/card:bg-text group-hover/card:text-background group-[.in-view]/card:bg-text group-[.in-view]/card:text-background hover:-translate-y-[0.2rem] hover:border-text hover:bg-background hover:text-text hover:[font-weight:bold] max-md:px-2.5 max-md:py-1 max-md:text-[clamp(0.9rem,5vw,1rem)]">
        {item}
      </span>
    ))
  }
</div>
