---
import Card from "../Card.astro";
import CardDivider from "../CardDivider.astro";
import CardSectionTitle from "../CardSectionTitle.astro";
import CardTitle from "../CardTitle.astro";
import SkillTags from "../SkillTags.astro";

const aiDataSkills = [
  "PyTorch",
  "Scikit-Learn",
  "OpenCV",
  "Numpy",
  "Pandas",
  "Matplotlib",
  "Wandb",
  "Gurobi Optimizer",
];

const automationSkills = ["LLM APIs & Agents", "n8n", "Dashboards & Streamlit"];

const devopsSkills = [
  "Docker",
  "Docker Compose",
  "GitHub Actions (CI/CD)",
  "Traefik",
  "Tailscale",
  "Uptime Kuma",
  "Linux Servers",
  "Homelab & Self-hosting",
  "SLURM & HPC",
];

const webDevelopmentSkills = [
  "HTML & CSS",
  "JavaScript",
  "React",
  "NodeJS",
  "Astro",
  "Tailwind CSS",
  "Django & DjangoREST",
  "Flask",
  "UX/UI Design",
  "Figma",
  "UX Testing",
];

const otherSkills = ["Git & GitHub", "C", "Assembly", "MATLAB", "ROS"];

const workSkills = [
  "Team Work",
  "Collaborative",
  "Client Interaction",
  "Problem Solving",
  "Identifying Value Creation",
];

const personalStrengths = [
  "Curiosity",
  "Polyhedric",
  "Constant Learner",
  "High Openness",
  "Entrepreneurially-minded",
];
---

<Card variant="cv-card">
  <CardTitle>Technical Skills</CardTitle>
  <CardSectionTitle>AI & Data Science</CardSectionTitle>
  <SkillTags items={aiDataSkills} />
  <CardSectionTitle>Automation & LLMs</CardSectionTitle>
  <SkillTags items={automationSkills} />
  <CardSectionTitle>DevOps & Infrastructure</CardSectionTitle>
  <SkillTags items={devopsSkills} />
  <CardSectionTitle>Web Development & Design</CardSectionTitle>
  <SkillTags items={webDevelopmentSkills} />
  <CardSectionTitle>Others</CardSectionTitle>
  <SkillTags items={otherSkills} />

  <CardDivider />

  <CardTitle>Soft Skills</CardTitle>
  <CardSectionTitle>Work and Group</CardSectionTitle>
  <SkillTags items={workSkills} />
  <CardSectionTitle>Personal Strengths</CardSectionTitle>
  <SkillTags items={personalStrengths} />
</Card>
