---
import type { CardVariant } from "../data/site";

interface Props {
  variant: CardVariant;
}

const { variant } = Astro.props;

// Hover-capable devices fill the card with its accent and invert its content; touch devices
// (`.in-view`, set on tap in home.js) only tint the CardTitle with `--card-accent`.
const variantClasses: Record<CardVariant, string> = {
  "project-1":
    "project-1 rounded-[2rem_0_2rem_0] [--card-accent:var(--color-primary)] hover:-translate-y-2 hover:rounded-none hover:bg-primary [&.in-view]:-translate-y-2 [&.in-view]:rounded-none",
  "project-2":
    "project-2 rounded-[0_2rem_0_2rem] [--card-accent:var(--color-primary)] hover:-translate-y-2 hover:rounded-none hover:bg-primary [&.in-view]:-translate-y-2 [&.in-view]:rounded-none",
  "cv-card":
    "cv-card [--card-accent:var(--color-secondary)] hover:-translate-y-2 hover:rounded-[1rem] hover:bg-secondary [&.in-view]:-translate-y-2 [&.in-view]:rounded-[1rem]",
  "contact-card":
    "contact-card rounded-[0_0_2rem_2rem] [--card-accent:var(--color-tertiary)] hover:-translate-y-2 hover:scale-105 hover:rounded-[2rem] hover:bg-tertiary [&.in-view]:-translate-y-2 [&.in-view]:scale-105 [&.in-view]:rounded-[2rem]",
  "blog-text":
    "blog-card rounded-[2rem_0_2rem_0] [--card-accent:var(--color-text)] hover:-translate-y-2 hover:rounded-none [&.in-view]:-translate-y-2 [&.in-view]:rounded-none",
  "blog-primary":
    "blog-card rounded-[2rem_0_2rem_0] [--card-accent:var(--color-primary)] hover:-translate-y-2 hover:rounded-none hover:bg-primary [&.in-view]:-translate-y-2 [&.in-view]:rounded-none",
  "blog-secondary":
    "blog-card rounded-[2rem_0_2rem_0] [--card-accent:var(--color-secondary)] hover:-translate-y-2 hover:rounded-none hover:bg-secondary [&.in-view]:-translate-y-2 [&.in-view]:rounded-none",
  "blog-tertiary":
    "blog-card rounded-[2rem_0_2rem_0] [--card-accent:var(--color-tertiary)] hover:-translate-y-2 hover:rounded-none hover:bg-tertiary [&.in-view]:-translate-y-2 [&.in-view]:rounded-none",
};
---

<article
  class:list={[
    "card group/card flex max-w-[800px] flex-col items-center justify-center border-[3px] border-text bg-background p-4 text-center transition-all duration-300 ease-in-out [-webkit-tap-highlight-color:transparent] select-none max-md:p-2 max-md:pb-4",
    variantClasses[variant],
  ]}
>
  <slot />
</article>
