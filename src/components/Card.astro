---
import type { CardVariant } from "../data/site";

interface Props {
  variant: CardVariant;
}

const { variant } = Astro.props;

const variantClasses: Record<CardVariant, string> = {
  "project-1":
    "project-1 rounded-[2rem_0_2rem_0] hover:-translate-y-2 hover:rounded-none hover:bg-primary [&.in-view]:-translate-y-2 [&.in-view]:rounded-none [&.in-view]:bg-primary",
  "project-2":
    "project-2 rounded-[0_2rem_0_2rem] hover:-translate-y-2 hover:rounded-none hover:bg-primary [&.in-view]:-translate-y-2 [&.in-view]:rounded-none [&.in-view]:bg-primary",
  "cv-card":
    "cv-card hover:-translate-y-2 hover:rounded-[1rem] hover:bg-secondary [&.in-view]:-translate-y-2 [&.in-view]:rounded-[1rem] [&.in-view]:bg-secondary",
  "contact-card":
    "contact-card rounded-[0_0_2rem_2rem] hover:-translate-y-2 hover:scale-105 hover:rounded-[2rem] hover:bg-tertiary [&.in-view]:-translate-y-2 [&.in-view]:scale-105 [&.in-view]:rounded-[2rem] [&.in-view]:bg-tertiary",
};
---

<article
  class:list={[
    "card group/card flex max-w-[800px] flex-col items-center justify-center border-[3px] border-text bg-background p-4 text-center transition-all duration-300 ease-in-out [-webkit-tap-highlight-color:transparent] select-none max-md:p-2 max-md:pb-4",
    variantClasses[variant],
  ]}
>
  <slot />
</article>
