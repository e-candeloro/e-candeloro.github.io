---
import { getCollection, render } from "astro:content";
import ButtonLink from "../../components/ButtonLink.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import Section from "../../components/Section.astro";
import SkillTags from "../../components/SkillTags.astro";
import { footer, navLinks, siteMeta } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.draft !== true);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const titleColorClasses = {
  text: "text-text",
  primary: "text-primary",
  secondary: "text-secondary",
  tertiary: "text-tertiary",
};
---

<Layout title={`${post.data.title} | ${siteMeta.title}`} description={post.data.description}>
  <Section id="blog-post" className="min-h-screen">
    <Nav links={navLinks} />

    <main class="mx-auto w-full max-w-[900px] px-8 py-12 max-md:px-4 max-md:py-8">
      <article class="rounded-[2rem] border-[3px] border-text bg-background px-8 py-10 text-text shadow-none max-md:px-4 max-md:py-6">
        <header class="mb-8 text-center">
          <p class="mb-3 text-base text-tertiary [font-weight:bold]">
            {dateFormatter.format(post.data.pubDate)}
          </p>
          <h1 class:list={["mx-auto text-[clamp(2rem,8vw,4rem)] leading-[1.05] [font-weight:bold] [text-wrap:balance]", titleColorClasses[post.data.titleColor]]}>
            {post.data.title}
          </h1>
          <p class="mx-auto mt-5 max-w-[720px] text-[clamp(1rem,4vw,1.25rem)] leading-7 text-text">
            {post.data.description}
          </p>
          {post.data.tags.length > 0 && <div class="mt-5 flex justify-center"><SkillTags items={post.data.tags} fillOnHover /></div>}
        </header>

        <div class="markdown-content mx-auto max-w-[720px]">
          <Content />
        </div>

        <div class="mt-10 text-center">
          <ButtonLink
            link={{
              href: "/blog/",
              label: "Back to Blog",
              ariaLabel: "Back to the blog list",
              variant: "secondary",
            }}
          />
        </div>
      </article>
    </main>

    <Footer textBeforeHeart={footer.textBeforeHeart} textAfterHeart={footer.textAfterHeart} />
  </Section>

  <script src="../../scripts/home.js"></script>
</Layout>
